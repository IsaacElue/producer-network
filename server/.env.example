# Spotify app credentials — create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Your Supabase project URL (used to verify user tokens via JWKS)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key (Settings → API) — used ONLY to write the Last.fm
# similar-artist cache. Never ships to the app.
SUPABASE_SERVICE_ROLE_KEY=

# Last.fm API key — create one free at https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# Only needed to run migrations / the smoke test from this machine:
# dashboard → Connect → Connection string (Session pooler URI), includes
# your database password.
SUPABASE_DB_URL=

PORT=3001
